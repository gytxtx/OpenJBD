<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/OpenJbdMaterialCard"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_4"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_14">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_18"
                android:layout_height="@dimen/icon_size_18"
                android:layout_marginEnd="@dimen/space_6"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt_24"
                app:tint="@color/icon_default" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/metric_voltage"
                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_voltage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_6"
            android:text="@string/placeholder_value"
            android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
