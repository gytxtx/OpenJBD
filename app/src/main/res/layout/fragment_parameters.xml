<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_18">

        <LinearLayout
            android:id="@+id/placeholder_parameters"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_24">

            <ImageView
                android:layout_width="@dimen/placeholder_illustration_size"
                android:layout_height="@dimen/placeholder_illustration_size"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info_24"
                app:tint="@color/icon_default" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_18"
                android:text="@string/parameters_placeholder_title"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_6"
                android:text="@string/parameters_placeholder_subtitle"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_parameters_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/parameters_group_connection" />

            <LinearLayout
                android:id="@+id/list_parameters_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_card_stroke"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/parameters_group_identity" />

            <LinearLayout
                android:id="@+id/list_parameters_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_card_stroke"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/parameters_group_capacity" />

            <LinearLayout
                android:id="@+id/list_parameters_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_card_stroke"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/parameters_group_electrical" />

            <LinearLayout
                android:id="@+id/list_parameters_electrical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_card_stroke"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="@string/parameters_group_status" />

            <LinearLayout
                android:id="@+id/list_parameters_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_card_stroke"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
