<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/device_top_app_bar"
        style="@style/Widget.OpenJbd.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:menu="@menu/device_toolbar_menu"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/text_primary"
        app:subtitle="@string/toolbar_devices_subtitle"
        app:subtitleTextColor="@color/text_secondary"
        app:title="@string/toolbar_devices_title"
        app:titleTextColor="@color/text_primary"
        app:itemIconTint="@color/text_primary" />

    <TextView
        android:id="@+id/txt_device_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/device_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/placeholder_devices"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/img_device_placeholder"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_bluetooth_searching_24" />

                <TextView
                    android:id="@+id/txt_device_placeholder_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:text="@string/device_placeholder_scanning_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_device_placeholder_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:text="@string/device_placeholder_scanning_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
