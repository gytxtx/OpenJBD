<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/device_top_app_bar"
        style="@style/Widget.OpenJbd.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        app:menu="@menu/device_toolbar_menu"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/toolbar_devices_title" />

    <TextView
        android:id="@+id/txt_device_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.OpenJbd.DeviceStatus" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/device_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:id="@+id/device_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/placeholder_devices"
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_24">

                    <ImageView
                        android:id="@+id/img_device_placeholder"
                        android:layout_width="@dimen/placeholder_illustration_size"
                        android:layout_height="@dimen/placeholder_illustration_size"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bluetooth_searching_24"
                        app:tint="@color/icon_default" />

                    <TextView
                        android:id="@+id/txt_device_placeholder_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="@dimen/space_18"
                        android:text="@string/device_placeholder_scanning_title"
                        android:textAppearance="@style/TextAppearance.OpenJbd.EmptyTitle" />

                    <TextView
                        android:id="@+id/txt_device_placeholder_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="@dimen/space_6"
                        android:text="@string/device_placeholder_scanning_subtitle"
                        android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_device_permission_action"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/action_grant_permission"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
