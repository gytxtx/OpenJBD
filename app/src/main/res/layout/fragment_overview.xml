<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overview_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_18">

        <LinearLayout
            android:id="@+id/placeholder_connect"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_24">

            <ImageView
                android:layout_width="@dimen/placeholder_illustration_size"
                android:layout_height="@dimen/placeholder_illustration_size"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bluetooth_searching_24"
                app:tint="@color/icon_default" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_18"
                android:text="@string/connect_placeholder_title"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_6"
                android:text="@string/connect_placeholder_subtitle"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_connected_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/banner_reconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:background="@color/surface"
                android:elevation="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_14"
                    android:paddingEnd="@dimen/space_16"
                    android:paddingBottom="@dimen/space_8">

                    <TextView
                        android:id="@+id/txt_reconnect_banner_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reconnect_banner_title"
                        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

                    <TextView
                        android:id="@+id/txt_reconnect_banner_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.OpenJbd.DeviceStatus" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_8">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_reconnect"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/action_cancel_reconnect"
                            android:text="@string/action_cancel"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16">

            <com.google.android.material.card.MaterialCardView
                style="@style/OpenJbdMaterialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txt_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingExtra="1dp"
                    android:padding="@dimen/space_14"
                    android:textAppearance="@style/TextAppearance.OpenJbd.DeviceStatus" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/OpenJbdMaterialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/state_of_charge"
                        android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                    <TextView
                        android:id="@+id/txt_soc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_4"
                        android:paddingBottom="@dimen/space_8"
                        android:text="@string/placeholder_percent"
                        android:textAppearance="@style/TextAppearance.OpenJbd.PrimaryMetricValue" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_soc"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/progress_track" />

                    <TextView
                        android:id="@+id/txt_soc_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_12"
                        android:text="@string/local_ble_note"
                        android:textAppearance="@style/TextAppearance.OpenJbd.Supporting" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <include layout="@layout/view_metric_voltage" />
                <include layout="@layout/view_metric_current" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <include layout="@layout/view_metric_power" />
                <include layout="@layout/view_metric_cycles" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <include layout="@layout/view_metric_capacity" />
                <include layout="@layout/view_metric_pack" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/OpenJbdMaterialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_widgets_outline_24"
                            app:tint="@color/icon_default" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/metric_status"
                            android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />
                    </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.OpenJbd.SecondaryPanel"
                    android:orientation="vertical"
                    >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/metric_mos"
                            android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                        <TextView
                            android:id="@+id/txt_mos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="@dimen/space_4"
                            android:text="@string/placeholder_value"
                            android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            style="@style/Widget.OpenJbd.SecondaryPanel"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/metric_balance"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_balance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="@dimen/space_4"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.StatusValue" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            style="@style/Widget.OpenJbd.SecondaryPanel"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/metric_protection"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_protection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="@dimen/space_4"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.StatusValue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/OpenJbdMaterialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_thermostat_24"
                            app:tint="@color/icon_default" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/metric_temperature"
                            android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_temperatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:text="@string/placeholder_value"
                        android:textAppearance="@style/TextAppearance.OpenJbd.StatusValue" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips_temperatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleLine="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/cell_voltages_title" />

            <LinearLayout
                android:id="@+id/cell_stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_min_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_cell_min"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="6dp"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_max_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_cell_max"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="6dp"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_delta_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_cell_delta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="6dp"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_average_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_cell_average"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="6dp"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_cells"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
