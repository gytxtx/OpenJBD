<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_40"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/space_40"
    android:paddingBottom="@dimen/space_28">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min">

        <ImageButton
            android:id="@+id/btn_dashboard_back"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/dashboard_text_primary" />

        <TextView
            android:id="@+id/txt_dashboard_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:paddingStart="@dimen/space_56"
            android:paddingEnd="@dimen/space_56"
            android:text="@string/dashboard_waiting_data"
            android:textAppearance="@style/TextAppearance.OpenJbd.DashboardStatus" />
    </FrameLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_18"
        android:layout_weight="1"
        android:alignmentMode="alignBounds"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <TextView
                android:id="@+id/txt_dashboard_soc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/placeholder_percent"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardPrimaryValue"
                app:autoSizeMaxTextSize="@dimen/dashboard_primary_value_size"
                app:autoSizeMinTextSize="@dimen/dashboard_primary_value_min_size"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/state_of_charge"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardLabel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <TextView
                android:id="@+id/txt_dashboard_voltage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/placeholder_voltage"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardMetricValue"
                app:autoSizeMaxTextSize="@dimen/dashboard_metric_value_size"
                app:autoSizeMinTextSize="@dimen/dashboard_metric_value_min_size"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/metric_voltage"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardLabel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <TextView
                android:id="@+id/txt_dashboard_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/placeholder_current"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardMetricValue"
                app:autoSizeMaxTextSize="@dimen/dashboard_metric_value_size"
                app:autoSizeMinTextSize="@dimen/dashboard_metric_value_min_size"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/metric_current"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardLabel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <TextView
                android:id="@+id/txt_dashboard_power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/placeholder_power"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardMetricValue"
                app:autoSizeMaxTextSize="@dimen/dashboard_metric_value_size"
                app:autoSizeMinTextSize="@dimen/dashboard_metric_value_min_size"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/metric_power"
                android:textAppearance="@style/TextAppearance.OpenJbd.DashboardLabel" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
